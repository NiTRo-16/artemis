# Copy to .env and fill in. Never commit .env.

# Your domain; its DNS A (and AAAA, if any) record must point at this server.
DOMAIN=artemis.example.com
# Let's Encrypt uses this for certificate expiry notices.
ACME_EMAIL=you@example.com

# Account emails (confirm address, reset password), sent through your email provider's SMTP server.
# Port 587 with starttls, or 465 with ssl. Use a sender address on your own domain.
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Artemis <no-reply@artemis.example.com>

# Optional "Continue with Google" sign-in (see DEPLOY.md). Set both, or leave both empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional blocklist lookups (both free). Leave empty to skip.
SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=

# Leave at 1. Set to 0 only if /healthz reports a sandbox error you can't fix on the host (see DEPLOY.md).
ARTEMIS_CHROMIUM_SANDBOX=1
